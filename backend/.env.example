# Salin ke backend/.env (file .env TIDAK di-commit) atau isi sebagai environment variable di hosting.

# --- Database (MongoDB Atlas) — khusus Gibran for 2029, terpisah dari data OurBuzzer lama ---
# MONGODB_URI boleh memakai cluster yang sama; isolasi data ditentukan oleh nama database (DB_NAME).
# (Nama variabel lama MONGO_URL tetap didukung.)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=gibran2029_db
# Isi campaign demo lama hanya untuk pengembangan lokal (jangan di produksi).
# SEED_DEMO_DATA=true

# --- App ---
ADMIN_EMAIL=admin@contoh.com
CORS_ORIGINS=*
# URL publik backend ini (tanpa / di akhir). Dipakai untuk callback_url Komerce dan URL gambar upload.
PUBLIC_BASE_URL=https://api.contoh.com

# --- Firebase Authentication (Google Sign-In dari aplikasi Flutter) ---
# Project ID Firebase (lihat google-services.json → project_info.project_id). Bukan rahasia.
FIREBASE_PROJECT_ID=jkweffect

# --- Komerce Payment (sandbox) ---
# Sandbox (terverifikasi): https://api-sandbox.collaborator.komerce.id/user
# Backend menambahkan /api/v1/user/payment/... di belakangnya.
# Production: ganti ke host production Komerce sesuai dashboard/dokumentasi Komerce.
KOMERCE_BASE_URL=https://api-sandbox.collaborator.komerce.id/user
KOMERCE_API_KEY=<api-key-sandbox-komerce>
# Cek otomatis status top up pending (detik). 0 = nonaktif.
KOMERCE_RECONCILE_SECONDS=60

# Admin Pusat (Owner) login via WhatsApp OTP (Fonnte)
FONNTE_TOKEN=
OWNER_PHONES=081234567890

# Komunitas Telegram: bot resmi (dari @BotFather) + link undangan grup/channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=OurBuzzerBot
TELEGRAM_GROUP_URL=https://t.me/+kodeUndanganGrup
